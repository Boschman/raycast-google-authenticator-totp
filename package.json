{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "google-authenticator-totp",
  "title": "Google Authenticator Time-Based One-Time Password (TOTP)",
  "description": "Get 2fa codes for Google Authenticator (TOTP)",
  "icon": "2fa-icon.png",
  "author": "Boschman",
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Google Authenticator",
      "description": "Get 2fa code",
      "mode": "view"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@raycast/api": "^2.3.1",
    "@raycast/utils": "^2.3.1",
    "totp-generator": "^2.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
